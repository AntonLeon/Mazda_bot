# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# chat_id мастеров через запятую (мастер обязан сам написать боту /start)
MASTER_IDS=
# Ссылка на чат: её покажем клиенту, если уведомление мастеру не доставилось
GROUP_LINK=https://t.me/MazdaAlex

# --- ИИ: выберите провайдер (или оставьте LLM_PROVIDER пустым — возьмётся первый с ключом) ---
# LLM_PROVIDER=nvidia | yandex | openrouter

# NVIDIA NIM. Ключ вида nvapi-…, подойдёт любое из имён:
#   NVIDIA_API_KEY | NVIDIA_NIM_API_KEY | NVAPI_KEY | NGC_API_KEY
# Внимание: из РФ сервис отвечает 451 независимо от ключа — нужен сервер не в РФ или прокси.
NVIDIA_API_KEY=
# ВАЖНО: NVIDIA периодически снимает модели с эксплуатации (ответ 410 Gone).
# Прежняя meta/llama-3.1-8b-instruct отключена 26.08.2026.
# Рабочие модели этого аккаунта: google/diffusiongemma-26b-a4b-it (быстрая),
# meta/llama-3.2-11b-vision-instruct (медленнее, 10-60 с), nvidia/nemotron-3-super-120b-a12b (reasoning)
# Часть моделей каталога не подключена к аккаунту и отвечает 404 «Not found for account».
# Полный список: curl -H "Authorization: Bearer $NVIDIA_API_KEY" https://integrate.api.nvidia.com/v1/models
# Основная модель: google/diffusiongemma-26b-a4b-it (быстрая, отвечает 0.5-1.5 с)
NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it
# Запасные модели: используются, если основная недоступна или вернула пустой ответ
NVIDIA_FALLBACK_MODELS=meta/llama-3.2-11b-vision-instruct,nvidia/nemotron-3-super-120b-a12b

# YandexGPT: API-ключ сервисного аккаунта и id каталога.
# Альтернативные имена: YANDEX_API_KEY | YC_API_KEY и YANDEX_FOLDER_ID | YC_FOLDER_ID | YANDEX_CATALOG_ID
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest

# OpenRouter (ключ вида sk-or-…)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Прокси для запросов к ИИ и поиску (необязательно) ---
# Бот учитывает HTTPS_PROXY/HTTP_PROXY из окружения. Пример:
# HTTPS_PROXY=http://user:pass@proxy-host:3128

# --- Поиск в интернете и подробность ответов ---
# Автопоиск: ИИ сам ищет в интернете под вопрос и отвечает по фактам (1 — вкл, 0 — выкл)
AUTO_SEARCH=1
# Сколько ссылок-источников добавлять в конец ответа
MAX_SEARCH_SOURCES=3

# --- Эксплуатация (необязательно) ---
# Часовой пояс для дат записей (по умолчанию Europe/Moscow; нужен tzdata в системе)
# BOT_TIMEZONE=Europe/Moscow
# Каталог для заявок (по умолчанию ./data)
# DATA_DIR=
# Пауза между сообщениями одного пользователя, секунды (0 — выключить)
# RATE_LIMIT_SECONDS=3
# Таймаут запроса к ИИ, секунды (reasoning-модели отвечают 5-60 с)
# LLM_TIMEOUT=120
# Лимит токенов ответа (влияет на длину и подробность)
# LLM_MAX_TOKENS=1500
# Сколько сообщений диалога держать в контексте ИИ
# MAX_HISTORY_MESSAGES=20
